generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  WAITER
  KITCHEN
}

model Restaurant {
  id String @id @default(cuid())
  name String
  slug String @unique
  logoUrl String?
  loginImageUrl String?
  legalName String?
  address String?
  city String?
  postalCode String?
  oib String?
  phone String?
  email String?
  website String?
  iban String?
  vatNumber String?
  description String?
  workingHours String?
  isDemo      Boolean   @default(false)
  expiresAt   DateTime?
  convertedAt DateTime?
  serviceMode String @default("TABLE") // TABLE=konobar, BAR=sank
  paymentCashEnabled Boolean @default(true)
  paymentCardTerminalEnabled Boolean @default(true)
  paymentCardOnlineEnabled Boolean @default(false)
  paymentProvider String? @default("stripe")
  paymentTestMode Boolean @default(true)
  stripePublicKey String?
  stripeSecretKey String?
  stripeWebhookSecret String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  tables Table[]
  categories MenuCategory[]
  items MenuItem[]
  orders Order[]
  upsellRules UpsellRule[]
}

model User {
  totp_secret   String?  @db.Text
  totp_enabled  Boolean  @default(false)
  id String @id @default(cuid())
  email String @unique
  password String
  name String?
  role Role @default(WAITER)
  restaurantId String?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id String @id @default(cuid())
  number Int
  qrSlug String @unique
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders Order[]
  createdAt DateTime @default(now())
  @@unique([restaurantId, number])
}

model MenuCategory {
  id String @id @default(cuid())
  name String
  nameEn String?
  nameDe String?
  order Int @default(0)
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parentId String?
  parent MenuCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuCategory[] @relation("CategoryHierarchy")
  imageUrl String?
  description String?
  sendsToKitchen Boolean @default(false)
  items MenuItem[]
  createdAt DateTime @default(now())
  @@index([restaurantId, parentId])
}

model MenuItem {
  id String @id @default(cuid())
  name String
  nameEn String?
  nameDe String?
  description String?
  descriptionEn String?
  descriptionDe String?
  price Float
  available Boolean @default(true)
  isBoosted Boolean @default(false)
  boostLevel Int @default(0)
  imageUrl String?
  allergens String?
  allergensNote String?
  allergensNoteEn String?
  allergensNoteDe String?
  order Int @default(0)
  upsellEnabled Boolean @default(true)
  categoryId String
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  upsellSource UpsellRule[] @relation("UpsellSource")
  upsellTarget UpsellRule[] @relation("UpsellTarget")
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(cuid())
  cancelReason String?
  cancelledAt DateTime?
  refundId String?
  refundStatus String?
  status String @default("pending")
  total Float
  tipPercent Int @default(0)
  tipAmount Float @default(0)
  tableId String
  table Table @relation(fields: [tableId], references: [id])
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items OrderItem[]
  paymentMethod String @default("CASH")
  paymentStatus String @default("PENDING")
  paymentIntentId String?
  paymentProvider String?
  paidAt DateTime?
  payments Payment[]
  createdAt DateTime @default(now())
}

model OrderItem {
  id String @id @default(cuid())
  quantity Int
  note String?
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  price Float
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount Float
  provider String @default("mock")
  providerIntentId String?
  status String @default("PENDING")
  tipAmount Float @default(0)
  stripeSessionId String? @unique
  rawResponse Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
}
model UpsellRule {
  id String @id @default(cuid())
  restaurantId String
  sourceId String
  targetId String
  strength Float @default(1.0)
  type String @default("COMPLEMENT")
  autoGenerated Boolean @default(false)
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  source MenuItem @relation("UpsellSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target MenuItem @relation("UpsellTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([sourceId, targetId])
  @@index([restaurantId])
}

model PlatformCompany {
  id String @id @default("1")
  naziv_obrta String? @default("CoreCode")
  oib String?
  broj_obrta String?
  adresa String?
  grad String?
  email String? @default("info@tableboost.app")
  web String? @default("https://tableboost.app")
  iban String?
  legal_visible Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
