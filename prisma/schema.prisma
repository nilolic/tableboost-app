generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  WAITER
  KITCHEN
}

model Restaurant {
  id String @id @default(cuid())
  name String
  slug String @unique
  logoUrl String?
  loginImageUrl String?
  legalName String?
  address String?
  city String?
  postalCode String?
  oib String?
  phone String?
  email String?
  website String?
  iban String?
  vatNumber String?
  description String?
  workingHours String?
  // Placanja
  paymentCashEnabled Boolean @default(true)
  paymentCardTerminalEnabled Boolean @default(true)
  paymentCardOnlineEnabled Boolean @default(false)
  paymentProvider String? @default("stripe")
  paymentTestMode Boolean @default(true)
  stripePublicKey String?
  stripeSecretKey String?
  stripeWebhookSecret String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  tables Table[]
  categories MenuCategory[]
  items MenuItem[]
  orders Order[]
  upsellRules UpsellRule[]
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  name String?
  role Role @default(WAITER)
  restaurantId String?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id String @id @default(cuid())
  number Int
  qrSlug String @unique
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders Order[]
  createdAt DateTime @default(now())
  @@unique([restaurantId, number])
}

model MenuCategory {
  id String @id @default(cuid())
  name String
  nameEn String?
  nameDe String?
  order Int @default(0)
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items MenuItem[]
  createdAt DateTime @default(now())
}

model MenuItem {
  id String @id @default(cuid())
  name String
  nameEn String?
  nameDe String?
  description String?
  descriptionEn String?
  descriptionDe String?
  price Float
  available Boolean @default(true)
  isBoosted Boolean @default(false)
  boostLevel Int @default(0)
  imageUrl String?
  order Int @default(0)
  upsellEnabled Boolean @default(true)
  categoryId String
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  upsellSource UpsellRule[] @relation("UpsellSource")
  upsellTarget UpsellRule[] @relation("UpsellTarget")
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(cuid())
  status String @default("pending")
  total Float
  tipPercent Int @default(0)
  tipAmount Float @default(0)
  tableId String
  table Table @relation(fields: [tableId], references: [id])
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items OrderItem[]
  paymentMethod String @default("CASH")
  paymentStatus String @default("PENDING")
  paymentIntentId String?
  paymentProvider String?
  paidAt DateTime?
  payments Payment[]
  createdAt DateTime @default(now())
}

model OrderItem {
  id String @id @default(cuid())
  quantity Int
  note String?
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  price Float
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount Float
  provider String @default("mock")
  providerIntentId String?
  status String @default("PENDING")
  tipAmount Float @default(0)
  stripeSessionId String? @unique
  rawResponse Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
}
model UpsellRule {
  id String @id @default(cuid())
  restaurantId String
  sourceId String
  targetId String
  strength Float @default(1.0)
  type String @default("COMPLEMENT")
  autoGenerated Boolean @default(false)
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  source MenuItem @relation("UpsellSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target MenuItem @relation("UpsellTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([sourceId, targetId])
  @@index([restaurantId])
}
